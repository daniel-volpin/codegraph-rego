NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASS=your_neo4j_password

OWASP_BENCHMARK_ROOT="/abs/path/to/BenchmarkJava"

# LM Studio / OpenAI-compatible endpoint
LLM_PROVIDER=openai
LLM_API_BASE=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=qwen3.5-9b-mlx
LLM_ENABLE_THINKING=false
LLM_CONCURRENCY=1
LLM_MAX_TOKENS_EXPLANATION=512
LLM_MAX_TOKENS_REMEDIATION=1024
LLM_MODEL_TTL_SECONDS=180

REMEDIATION_LLM_MODEL=qwen/qwen3-coder-30b
REMEDIATION_LLM_MAX_TOKENS=2048
REMEDIATION_LLM_TEMPERATURE=0.0
REMEDIATION_LLM_MODEL_TTL_SECONDS=300

REMEDIATION_RAW_CAPTURE_ENABLED=0
