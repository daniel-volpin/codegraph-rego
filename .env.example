# Neo4j Database Credentials
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASS=123456789

# LiteLLM / LLM provider
LLM_PROVIDER=openai                 # LM Studio speaks OpenAI-style APIs; override if using a different provider
LLM_API_BASE=http://127.0.0.1:1234/v1
LLM_API_KEY=lm-studio               # any non-empty value; LM Studio ignores it
LLM_MODEL=google/gemma-3-12b        # exact id from /v1/models (or whichever model you loaded)

# Optional diagnostics: write raw LLM outputs (only on JSON parse failures) into the remediation eval output dir.
# Default is OFF.
REMEDIATION_RAW_CAPTURE_ENABLED=0

# Optional OpenAI key if/when you switch back to OpenAI-hosted models
# OPENAI_API_KEY=
