# CodeGraph local configuration
# Copy this file to .env. Keep secrets out of git.
# Runtime defaults live in codegraph/config.py; only override them here when needed.

# ── Required ────────────────────────────────────────────────────────────────

# Neo4j
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASS=<your-local-neo4j-password>

# LLM provider — keep one provider block active.
# For benchmark runs, pin an exact model/version and record it in provenance.

# Hosted OpenAI-compatible provider (OpenAI, Azure OpenAI, gateways)
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=<your-openai-key>
LLM_MODEL=gpt-5.4
REMEDIATION_LLM_MODEL=gpt-5.4
LLM_API_MODE=auto

# Conservative hosted concurrency. Keep both at 1 for local models.
LLM_CONCURRENCY=4
LLM_MAX_CONCURRENT_REQUESTS=4

# Generation budgets
LLM_ENABLE_THINKING=false
LLM_MAX_TOKENS_EXPLANATION=512
LLM_MAX_TOKENS_REMEDIATION=4096
REMEDIATION_LLM_MAX_TOKENS=4096
REMEDIATION_LLM_TEMPERATURE=0.0

# Local OpenAI-compatible provider (example: LM Studio)
# Comment out the hosted block above before enabling this block.
# LLM_API_BASE=http://127.0.0.1:1234/v1
# LLM_API_KEY=lm-studio
# LLM_MODEL=qwen3.5-9b-mlx
# REMEDIATION_LLM_MODEL=qwen/qwen3-coder-30b
# LLM_API_MODE=auto
# LLM_CONCURRENCY=1
# LLM_MAX_CONCURRENT_REQUESTS=1
# LLM_MODEL_TTL_SECONDS=180
# REMEDIATION_LLM_MODEL_TTL_SECONDS=300

# ── Optional runtime overrides ──────────────────────────────────────────────

# Remediation
# REMEDIATION_RAW_CAPTURE_ENABLED=0
# REMEDIATION_CONFIDENCE_GATE_ENABLED=1
# REMEDIATION_CONFIDENCE_THRESHOLD_APPLY=0.75
# REMEDIATION_CONFIDENCE_THRESHOLD_REVIEW=0.50
# REMEDIATION_CONFIDENCE_TEMPERATURE=1.0
# REMEDIATION_TRACE_PROMPT_ENABLED=0
# UI_REVIEW_STORE_PATH=outputs/policy_ui_reviews/reviews.jsonl

# Detection engines
# Rules declare their owner through evidence_source in
# configs/benchmark/policy_registry.json. Disabling non-OPA engines reduces coverage.
# CODEGRAPH_DETECTION_ENGINES_ENABLED=true
# CODEGRAPH_OPENGREP_RULES_DIR=policy/opengrep
# CODEGRAPH_OPENGREP_TIMEOUT=120.0
# CODEGRAPH_OPA_TIMEOUT=120.0

# Java parser / ingestion
# JAVA_PARSER_JAR=tools/java-parser/target/codegraph-java-parser.jar
# JAVA_PARSER_LANGUAGE_LEVEL=25
# JAVA_PARSER_TIMEOUT_SECONDS=30.0
# JAVA_PARSER_HEAP_MB=384
# JAVA_PARSER_MAX_CONCURRENT_REQUESTS=4
# CODEGRAPH_INGESTION_WORKERS=4

# Upload limits
# UPLOAD_MAX_ARCHIVE_SIZE_BYTES=104857600
# UPLOAD_MAX_MEMBER_SIZE_BYTES=52428800
# UPLOAD_MAX_EXTRACTED_SIZE_BYTES=524288000
# UPLOAD_MAX_ARCHIVE_ENTRIES=10000
# UPLOAD_MAX_COMPRESSION_RATIO=100.0

# Git ingest (POST /upload/git). Analysed code may later be compiled; keep the allowlist narrow.
# UPLOAD_GIT_ALLOWED_HOSTS=github.com
# UPLOAD_GIT_TIMEOUT_SECONDS=300.0

# Telemetry
OTEL_SDK_DISABLED=true
# OTEL_TRACE_FILE=outputs/traces.jsonl
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
