# CodeGraph configuration template. Copy to .env and fill the placeholders.
# .env is gitignored and must never be committed.

# ── Telemetry (OpenTelemetry) ───────────────────────────────────────────────
OTEL_SDK_DISABLED=true                                  # silence tracing (tests/local runs)
# OTEL_TRACE_FILE=outputs/traces.jsonl                  # spans to file instead of stdout
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317     # export to Grafana/Tempo

# ── Neo4j (required) ────────────────────────────────────────────────────────
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASS=<your-local-neo4j-password>

# ── LLM provider ────────────────────────────────────────────────────────────
# Keep exactly one provider block active. Duplicate keys resolve to the LAST
# occurrence, which hides mistakes — LLM_MODEL especially must be set for the
# provider in use, or explanation calls go to the wrong model.
#
# Verify a hosted model id and its retirement date before a benchmark run:
#   curl https://api.openai.com/v1/models -H "Authorization: Bearer $KEY"
# Record the resolved model in provenance.json; a floating alias makes a run
# unrepeatable once the snapshot behind it changes.

# --- Hosted, OpenAI-compatible (OpenAI, Azure OpenAI, gateways) ---
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=<your-openai-key>
LLM_MODEL=gpt-5.4                                       # explanation path — REQUIRED
REMEDIATION_LLM_MODEL=gpt-5.4                           # remediation path
LLM_API_MODE=auto                                        # auto | responses | chat_completions
LLM_CONCURRENCY=4                                        # hosted API: no unified-memory limit
LLM_MAX_CONCURRENT_REQUESTS=4
LLM_ENABLE_THINKING=false
LLM_MAX_TOKENS_EXPLANATION=512
LLM_MAX_TOKENS_REMEDIATION=1024
REMEDIATION_LLM_MAX_TOKENS=2048
REMEDIATION_LLM_TEMPERATURE=0.0

# --- Local, OpenAI-compatible (LM Studio, Ollama) ---
# Reproducible baseline: no paid key, no source leaving the machine.
# LM Studio serves /v1 on 1234; Ollama on 11434.
# LLM_API_BASE=http://localhost:1234/v1
# LLM_API_KEY=lm-studio
# LLM_MODEL=qwen3.5-9b-mlx
# REMEDIATION_LLM_MODEL=qwen/qwen3-coder-30b
# LLM_MODEL_TTL_SECONDS=180                             # LM Studio auto-evict hint
# REMEDIATION_LLM_MODEL_TTL_SECONDS=300
# LLM_CONCURRENCY=1                                      # protects Apple Silicon unified memory
# LLM_MAX_CONCURRENT_REQUESTS=1

# ── Remediation gates ───────────────────────────────────────────────────────
REMEDIATION_RAW_CAPTURE_ENABLED=0
REMEDIATION_CONFIDENCE_GATE_ENABLED=1
REMEDIATION_CONFIDENCE_THRESHOLD_APPLY=0.75
REMEDIATION_CONFIDENCE_THRESHOLD_REVIEW=0.50
REMEDIATION_CONFIDENCE_TEMPERATURE=1.0
REMEDIATION_TRACE_PROMPT_ENABLED=0
UI_REVIEW_STORE_PATH=outputs/policy_ui_reviews/reviews.jsonl

# ── Detection engines ───────────────────────────────────────────────────────
# Rules declare their engine via evidence_source in
# configs/benchmark/policy_registry.json. Disabling drops the rules an engine
# owns, so coverage falls: for triage, not normal operation.
# CODEGRAPH_DETECTION_ENGINES_ENABLED=true
# CODEGRAPH_OPENGREP_RULES_DIR=policy/opengrep
# CODEGRAPH_OPENGREP_TIMEOUT=120.0
# CODEGRAPH_OPA_TIMEOUT=120.0

# ── Java parser (Eclipse JDT) ───────────────────────────────────────────────
# JAVA_PARSER_JAR=tools/java-parser/target/codegraph-java-parser.jar
# JAVA_PARSER_LANGUAGE_LEVEL=25

# ── Upload limits ───────────────────────────────────────────────────────────
UPLOAD_MAX_ARCHIVE_SIZE_BYTES=104857600
UPLOAD_MAX_MEMBER_SIZE_BYTES=52428800
UPLOAD_MAX_EXTRACTED_SIZE_BYTES=524288000
UPLOAD_MAX_ARCHIVE_ENTRIES=10000
UPLOAD_MAX_COMPRESSION_RATIO=100.0
