            "methodKey": "6db8465391b02435@80b85e77fc4415f769c636d1683577d06e4eaa749cf964d339385521f10bb3a7:benchmark-framework-demo/src/main/java/org/owasp/benchmark/helpers/DataBaseServer.java#file:benchmark-framework-demo/src/main/java/org/owasp/benchmark/helpers/DataBaseServer.java#type:org.owasp.benchmark.helpers.DataBaseServer#range:1437-3972#method:getAll/2/javax.servlet.http.HttpServletRequest,javax.servlet.http.HttpServletResponse#range:2370-3497",
