# Generated evaluation outputs — all ignored except thesis final baselines
# Note: must use outputs/* (not outputs/) so negations can re-include subdirs
outputs/*
!outputs/thesis_final_detection_full/
!outputs/thesis_final_explanation_full/
!outputs/thesis_final_remediation_v2/
# Ephemeral run artifacts within the thesis finals (not evidence)
