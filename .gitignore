# Generated evaluation outputs.
# Note: must use outputs/* (not outputs/) so negations can re-include subdirs.
# Policy: keep the full remediation v2 baseline in git; allow only compact
# summary/provenance files for thesis-useful follow-up reruns.
outputs/*

# Canonical thesis-final baselines (full evidence kept in git)
!outputs/thesis_final_remediation_v2/

# Thesis-useful follow-up reruns (top-level summary + provenance only)
!outputs/thesis_final_detection_full_v2/
outputs/thesis_final_detection_full_v2/*
!outputs/thesis_final_detection_full_v2/metrics.csv
!outputs/thesis_final_detection_full_v2/metrics.json
!outputs/thesis_final_detection_full_v2/provenance.json
!outputs/thesis_final_detection_full_v2/table.md

!outputs/thesis_final_explanation_full_v2/
outputs/thesis_final_explanation_full_v2/*
!outputs/thesis_final_explanation_full_v2/citation_metrics.csv
!outputs/thesis_final_explanation_full_v2/citation_metrics.json
!outputs/thesis_final_explanation_full_v2/provenance.json
!outputs/thesis_final_explanation_full_v2/table.md

!outputs/thesis_final_remediation_v3/
outputs/thesis_final_remediation_v3/*
!outputs/thesis_final_remediation_v3/confidence_calibration.json
!outputs/thesis_final_remediation_v3/provenance.json
!outputs/thesis_final_remediation_v3/remediation_calibration.json
!outputs/thesis_final_remediation_v3/remediation_calibration.md
!outputs/thesis_final_remediation_v3/remediation_metrics.csv
!outputs/thesis_final_remediation_v3/remediation_metrics.json
!outputs/thesis_final_remediation_v3/summary.md
!outputs/thesis_final_remediation_v3/table.md

!outputs/pr_full_verification_2026-05-11/
outputs/pr_full_verification_2026-05-11/*
!outputs/pr_full_verification_2026-05-11/detection_full/
!outputs/pr_full_verification_2026-05-11/explanation_full/
!outputs/pr_full_verification_2026-05-11/remediation_supported_medium/

outputs/pr_full_verification_2026-05-11/detection_full/*
!outputs/pr_full_verification_2026-05-11/detection_full/metrics.csv
!outputs/pr_full_verification_2026-05-11/detection_full/metrics.json
