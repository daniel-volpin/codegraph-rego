# Backend Dockerfile
FROM python:3.14-slim

WORKDIR /app

# Install uv
RUN pip install uv

# Copy dependency definition
COPY pyproject.toml .

# Install dependencies
RUN uv pip install --system -r pyproject.toml

# Copy application code
COPY . .

# Expose port
EXPOSE 8000

# Command
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
