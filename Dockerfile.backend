FROM maven:3.9.16-eclipse-temurin-21@sha256:a972570be789ee5c9fa23446a8914ac7327560b5c022f662cfa9452aef829f18 AS java-parser-build

WORKDIR /java-parser
COPY tools/java-parser/pom.xml tools/java-parser/settings.xml ./
COPY tools/java-parser/src ./src
RUN mvn --batch-mode --no-transfer-progress --settings settings.xml package

FROM python:3.14.7-slim-trixie@sha256:cad9a2c871761c413caa6fdd6441c783451e740a48aaeba60ae62a8b53525ef6

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends openjdk-21-jre-headless && \
    apt-get clean

# Install uv
RUN pip install --no-cache-dir uv==0.12.13

# Install OPA so readiness checks and policy evaluation work inside the container too.
# Pin to the same version as scripts/setup_benchmark_env.sh so benchmark numbers
# are comparable across the current source baseline. Historical thesis results
# retain their original engine provenance and must not be relabeled.
ARG OPA_VERSION=v1.20.2
RUN set -eux; \
    arch="$(uname -m)"; \
    case "$arch" in \
      x86_64) opa_arch="amd64" ;; \
      aarch64|arm64) opa_arch="arm64" ;; \
      *) echo "Unsupported architecture: $arch" >&2; exit 1 ;; \
    esac; \
    python -c "import pathlib, sys, urllib.request; url = f'https://github.com/open-policy-agent/opa/releases/download/{sys.argv[1]}/opa_linux_{sys.argv[2]}_static'; target = pathlib.Path('/usr/local/bin/opa'); target.write_bytes(urllib.request.urlopen(url).read()); target.chmod(0o755)" "$OPA_VERSION" "$opa_arch"; \
    opa version

# Copy dependency metadata
COPY pyproject.toml uv.lock ./

# Install locked runtime dependencies without re-resolving the project.
RUN uv export \
      --frozen \
      --no-dev \
      --no-editable \
      --no-emit-project \
      --format requirements.txt \
      --output-file requirements.lock && \
    uv pip install --system -r requirements.lock && \
    rm requirements.lock

# Copy only the backend application surface needed at runtime.
COPY app.py ./
COPY api ./api
COPY codegraph ./codegraph
COPY configs ./configs
COPY policy ./policy
COPY --from=java-parser-build /java-parser/target/codegraph-java-parser.jar \
    ./tools/java-parser/target/codegraph-java-parser.jar

# Expose port
EXPOSE 8000

# Command
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
