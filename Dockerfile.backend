FROM maven:3-eclipse-temurin-26@sha256:c30718f442eb39c55b2d45440bb849d8755ad8d9d6ef67aadefcce150267116f AS java-parser-build

WORKDIR /java-parser
COPY tools/java-parser/pom.xml tools/java-parser/settings.xml ./
COPY tools/java-parser/src ./src
RUN mvn --batch-mode --no-transfer-progress --settings settings.xml package

FROM python:3.14.7-slim-trixie@sha256:cad9a2c871761c413caa6fdd6441c783451e740a48aaeba60ae62a8b53525ef6

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends openjdk-21-jre-headless && \
    apt-get clean

# Install uv
RUN pip install --no-cache-dir uv==0.12.13

# Install OPA so readiness checks and policy evaluation work inside the container too.
# Pin to the same version as scripts/setup_benchmark_env.sh so benchmark numbers
# are comparable across the current source baseline. Historical thesis results
# retain their original engine provenance and must not be relabeled.
ARG OPA_VERSION=v1.20.2
RUN set -eux; \
    arch="$(uname -m)"; \
    case "$arch" in \
      x86_64) opa_arch="amd64" ;; \
      aarch64|arm64) opa_arch="arm64" ;; \
      *) echo "Unsupported architecture: $arch" >&2; exit 1 ;; \
    esac; \
    python -c "import pathlib, sys, urllib.request; url = f'https://github.com/open-policy-agent/opa/releases/download/{sys.argv[1]}/opa_linux_{sys.argv[2]}_static'; target = pathlib.Path('/usr/local/bin/opa'); target.write_bytes(urllib.request.urlopen(url).read()); target.chmod(0o755)" "$OPA_VERSION" "$opa_arch"; \
    opa version

# Copy dependency metadata
COPY pyproject.toml uv.lock ./

# Install locked runtime dependencies without re-resolving the project.
# requirements.txt export drops uv.lock's custom index routing (pyproject.toml's
# [tool.uv.sources]/[[tool.uv.index]] pin torch to the CPU-only wheel index), so
# uv pip install needs that index passed explicitly to resolve the pinned
# torch==...+cpu hash. unsafe-best-match lets other packages still resolve from
# PyPI when the pytorch index happens to also carry their name; every package
# here is still hash-pinned, so this can't silently substitute a different file.
RUN uv export \
      --frozen \
      --no-dev \
      --no-editable \
      --no-emit-project \
      --format requirements.txt \
      --output-file requirements.lock && \
    uv pip install --system --index-strategy unsafe-best-match --extra-index-url https://download.pytorch.org/whl/cpu -r requirements.lock && \
    rm requirements.lock

# Copy only the backend application surface needed at runtime.
COPY app.py ./
COPY api ./api
COPY codegraph ./codegraph
COPY configs ./configs
COPY policy ./policy
COPY --from=java-parser-build /java-parser/target/codegraph-java-parser.jar \
    ./tools/java-parser/target/codegraph-java-parser.jar

# Configure non-root runtime user for container security
RUN useradd -u 10001 -U -d /app -s /bin/sh codegraph && \
    mkdir -p /app/uploaded_code /app/index /app/outputs /app/logs && \
    chown -R codegraph:codegraph /app

USER codegraph

# Expose port
EXPOSE 8000

# Container Healthcheck
HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=3 \
  CMD python -c "import http.client as c; conn = c.HTTPConnection('localhost', 8000, timeout=5); conn.request('GET', '/health'); exit(0 if conn.getresponse().status in (200, 503) else 1)" || exit 1

# Command
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
